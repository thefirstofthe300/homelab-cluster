{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "flux": {
    "managerFilePatterns": [
      "/manifests/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Paperless-ngx image tag in HelmRelease values",
      "managerFilePatterns": ["/^manifests/paperless-ngx/helm\\.yaml$/"],
      "matchStrings": ["tag: \"(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""],
      "autoReplaceStringTemplate": "tag: \"{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\"",
      "depNameTemplate": "ghcr.io/paperless-ngx/paperless-ngx",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["dock.mau.dev/mautrix/signal"],
      "allowedVersions": "/^v0\\./"
    },
    {
      "description": "Flux image automation owns tags and digests for these images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "jellyfin/jellyfin",
        "nextcloud",
        "dock.mau.dev/mautrix/discord",
        "dock.mau.dev/mautrix/gmessages",
        "dock.mau.dev/mautrix/signal",
        "ghcr.io/thefirstofthe300/rust-synapse-compress-state"
      ],
      "enabled": false
    }
  ]
}
