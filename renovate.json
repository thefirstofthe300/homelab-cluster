{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "flux": {
    "managerFilePatterns": [
      "/manifests/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": ["dock.mau.dev/mautrix/signal"],
      "allowedVersions": "/^v0\\./"
    },
    {
      "description": "Flux image automation owns tags and digests for these images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "jellyfin/jellyfin",
        "nextcloud",
        "dock.mau.dev/mautrix/discord",
        "dock.mau.dev/mautrix/gmessages",
        "dock.mau.dev/mautrix/signal",
        "ghcr.io/thefirstofthe300/rust-synapse-compress-state"
      ],
      "enabled": false
    }
  ]
}
